# ============================================================================
# Django Configuration
# ============================================================================

# Django secret key (generate a strong key for production)
SECRET_KEY=your-secret-key-here

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated, use * for development only)
ALLOWED_HOSTS=localhost,127.0.0.1,*

# ============================================================================
# LlamaCloud / LlamaExtract Configuration
# ============================================================================

# LlamaCloud API Key (REQUIRED for extraction)
# Get your key from: https://cloud.llamaindex.ai
# Sign up, go to API Keys section, and create a new key
LLAMAAPI_KEY=llx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Database Configuration (Optional - SQLite used by default)
# ============================================================================

# Uncomment and configure if using PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ============================================================================
# CORS Configuration
# ============================================================================

# Allow all origins (development only)
CORS_ALLOW_ALL_ORIGINS=True

# Specific allowed origins (production - comma separated)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# Media Files Configuration
# ============================================================================

# Media root directory (where uploaded files are stored)
# Default: media/ in project root
# MEDIA_ROOT=/path/to/media/files

# Media URL prefix
# Default: /media/
# MEDIA_URL=/media/

# ============================================================================
# Google Gemini Configuration (For intelligent re-extraction)
# ============================================================================

# Option 1: API Key (simplest, good for development)
# Get your key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSy...

# Option 2: Service Account Credentials (recommended for production)
# Path to your service account JSON file (for local development)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/factura-json-apikeys.json

# OR for Railway/production: Set GOOGLE_SERVICE_ACCOUNT_JSON with the entire JSON content
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google Cloud Project ID (only if using service account)
GOOGLE_CLOUD_PROJECT=factura-json

# Google Cloud Location (optional, default: us-central1)
GOOGLE_CLOUD_LOCATION=us-central1

# ============================================================================
# Logging Configuration (Optional)
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# NOTES
# ============================================================================

# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit .env to version control
# 3. The LLAMAAPI_KEY is the most important - without it, extraction won't work
# 4. For Gemini, use GOOGLE_API_KEY for development or GOOGLE_SERVICE_ACCOUNT_JSON for production
# 5. For development, the default SQLite database is sufficient
# 6. For production, use PostgreSQL and set proper security settings

