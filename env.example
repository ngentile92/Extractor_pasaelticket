# ============================================================================
# Django Configuration
# ============================================================================

# Django secret key (generate a strong key for production)
SECRET_KEY=your-secret-key-here

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated, use * for development only)
ALLOWED_HOSTS=localhost,127.0.0.1,*

# ============================================================================
# LlamaCloud / LlamaExtract Configuration
# ============================================================================

# LlamaCloud API Key (REQUIRED for extraction)
# Get your key from: https://cloud.llamaindex.ai
# Sign up, go to API Keys section, and create a new key
LLAMAAPI_KEY=llx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Database Configuration (Optional - SQLite used by default)
# ============================================================================

# Uncomment and configure if using PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ============================================================================
# CORS Configuration
# ============================================================================

# Allow all origins (development only)
CORS_ALLOW_ALL_ORIGINS=True

# Specific allowed origins (production - comma separated)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# Media Files Configuration
# ============================================================================

# Media root directory (where uploaded files are stored)
# Default: media/ in project root
# MEDIA_ROOT=/path/to/media/files

# Media URL prefix
# Default: /media/
# MEDIA_URL=/media/

# ============================================================================
# Logging Configuration (Optional)
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# NOTES
# ============================================================================

# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit .env to version control
# 3. The LLAMAAPI_KEY is the most important - without it, extraction won't work
# 4. For development, the default SQLite database is sufficient
# 5. For production, use PostgreSQL and set proper security settings

